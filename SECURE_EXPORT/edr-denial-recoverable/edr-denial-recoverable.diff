@@ -5,6 +5,15 @@ const pending = new Set();
 export const securitySnapshot = () => snapshot;
 export const subscribeSecurity = (fn) => { listeners.add(fn); return () => listeners.delete(fn); };
 export function invalidateSecurity(reason = "scope", deniedPath = null) {
+  // A DENIAL ALREADY LATCHED FOR THE SAME PATH IS NOT NEWS. Re-latching it
+  // bumped the epoch, which remounted the surface, which re-ran the read that
+  // was refused, which latched again — the "Recheck access" loop, and a
+  // request storm behind it. The latch is presentation state only, so making
+  // the identical latch idempotent denies nothing less: the FIRST one still
+  // stands, a denial for a DIFFERENT path still latches, and any other reason
+  // (scope, session, expired, permission) still invalidates.
+  if (reason === "denied" && snapshot.reason === "denied"
+      && snapshot.deniedPath === deniedPath) return;
   snapshot = { epoch: snapshot.epoch + 1, reason, deniedPath };
   for (const cancel of [...pending]) cancel();
   for (const listener of [...listeners]) listener();
diff --git a/apps/nivxray-xdr/src/nivxforge/EdrAccessNotice.jsx b/apps/nivxray-xdr/src/nivxforge/EdrAccessNotice.jsx
new file mode 100644
