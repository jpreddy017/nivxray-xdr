--- /dev/null
+++ b/apps/nivxray-xdr/src/nivxforge/EdrAccessNotice.jsx
@@ -0,0 +1,27 @@
+import React from "react";
+import { useLocation } from "react-router-dom";
+import NivXForgeConsole from "@/nivxforge/NivXForgeConsole";
+
+/**
+ * A page refusal inside the EDR plane, with the PLANE STILL AROUND IT.
+ *
+ * A latched route denial used to replace the whole console with a bare
+ * sentence and one button. That is what made the `/edr` loop unrecoverable
+ * rather than merely wrong: the customer pill, the product navigation and
+ * sign-out all disappeared with the page, so the one action that could
+ * change the server's answer — selecting a customer — was unreachable, and
+ * "Recheck access" could only re-run the request that had just been refused.
+ *
+ * Nothing here grants anything. The refusal is rendered verbatim, the page
+ * body stays unloaded, and the backend remains the authority; the operator
+ * simply keeps the controls that can resolve it.
+ */
+export default function EdrAccessNotice({ children }) {
+  const { pathname } = useLocation();
+  const activeTab = pathname.split("/")[2] || "overview";
+  return (
+    <NivXForgeConsole activeTab={activeTab}>
+      <div data-testid="edr-access-notice">{children}</div>
+    </NivXForgeConsole>
+  );
+}
