diff --git a/apps/nivxray-xdr/src/lib/__tests__/edrDenialIsRecoverable.test.jsx b/apps/nivxray-xdr/src/lib/__tests__/edrDenialIsRecoverable.test.jsx
new file mode 100644
index 00000000..21f3ac65
--- /dev/null
+++ b/apps/nivxray-xdr/src/lib/__tests__/edrDenialIsRecoverable.test.jsx
@@ -0,0 +1,145 @@
+/**
+ * EDR access · a refusal must be RECOVERABLE, not a dead end.
+ *
+ * The TENANT_REQUIRED misclassification was the cause of the `/edr` loop; this
+ * suite pins the two properties that made the loop unrecoverable rather than
+ * merely wrong, so a DIFFERENT refusal code can never reproduce it:
+ *
+ *   1. re-latching the SAME denial for the SAME path is idempotent. It used to
+ *      bump the epoch, remount the surface, re-run the refused read and latch
+ *      again — a render/request storm with "Recheck access" apparently doing
+ *      nothing;
+ *   2. a latched denial keeps the EDR plane around it, so the customer pill,
+ *      the product navigation and sign-out stay reachable. A bare sentence and
+ *      one button leaves the operator with no action that can change the
+ *      server's answer.
+ *
+ * Nothing is granted here: the refusal is still rendered, the page body is
+ * still not loaded, and every genuine denial still latches.
+ */
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { StaticRouter } from "react-router-dom/server";
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+
+import { invalidateSecurity, securitySnapshot } from "../securityState";
+import { Protected } from "@/App";
+import EdrAccessNotice from "@/nivxforge/EdrAccessNotice";
+import { PermissionNotice } from "@/xdr/access/RequirePermission";
+
+const access = vi.hoisted(() => ({ loading: false, answer: true }));
+vi.mock("@/xdr/access/AccessProvider", () => ({
+  useAccess: () => ({ loading: access.loading,
+                      canAny: () => access.answer, refresh: vi.fn() }),
+  AccessProvider: ({ children }) => children,
+}));
+vi.mock("@/lib/auth", () => ({
+  useAuth: () => ({ user: { email: "operator@synthetic" }, loading: false }),
+}));
+vi.mock("@/nivxforge/NivXForgeConsole", () => ({
+  default: ({ activeTab, children }) => (
+    <div data-testid="edr-console-shell" data-active-tab={activeTab}>
+      <div data-testid="edr-customer-pill">customer picker</div>
+      {children}
+    </div>),
+}));
+
+let loaded;
+function Dashboard() { loaded(); return <div>EDR dashboard</div>; }
+const render = (path) => renderToStaticMarkup(
+  <StaticRouter location={path}><Protected><Dashboard /></Protected></StaticRouter>);
+
+beforeEach(() => {
+  const values = new Map([["nvx_token", "synthetic-session"]]);
+  const storage = { getItem: (k) => values.get(k) || null,
+                    setItem: (k, v) => values.set(k, v),
+                    removeItem: (k) => values.delete(k) };
+  globalThis.window = Object.assign(new EventTarget(),
+    { localStorage: storage, location: { pathname: "/edr" } });
+  globalThis.localStorage = storage;
+  loaded = vi.fn();
+  access.loading = false;
+  access.answer = true;
+  invalidateSecurity("scope");
+});
+afterEach(() => {
+  invalidateSecurity("scope");
+  delete globalThis.window;
+  delete globalThis.localStorage;
+});
+
+describe("the denial latch is idempotent", () => {
+  it("re-latching the same path does not bump the epoch or notify again", () => {
+    invalidateSecurity("denied", "/edr");
+    const latched = securitySnapshot().epoch;
+    const seen = vi.fn();
+    invalidateSecurity("denied", "/edr");
+    invalidateSecurity("denied", "/edr");
+    expect(securitySnapshot().epoch).toBe(latched);
+    expect(securitySnapshot().reason).toBe("denied");
+    expect(securitySnapshot().deniedPath).toBe("/edr");
+    expect(seen).not.toHaveBeenCalled();
+  });
+
+  it("a denial for a DIFFERENT path still latches", () => {
+    invalidateSecurity("denied", "/edr");
+    const latched = securitySnapshot().epoch;
+    invalidateSecurity("denied", "/edr/computers");
+    expect(securitySnapshot().epoch).toBeGreaterThan(latched);
+    expect(securitySnapshot().deniedPath).toBe("/edr/computers");
+  });
+
+  it("every other reason still invalidates while a denial is latched", () => {
+    invalidateSecurity("denied", "/edr");
+    for (const reason of ["permission", "scope", "session", "expired"]) {
+      const before = securitySnapshot().epoch;
+      invalidateSecurity(reason);
+      expect(securitySnapshot().epoch).toBeGreaterThan(before);
+      expect(securitySnapshot().reason).toBe(reason);
+    }
+  });
+
+  it("a denial latches again after it has been cleared", () => {
+    invalidateSecurity("denied", "/edr");
+    invalidateSecurity("permission");
+    const cleared = securitySnapshot().epoch;
+    invalidateSecurity("denied", "/edr");
+    expect(securitySnapshot().epoch).toBeGreaterThan(cleared);
+    expect(securitySnapshot().reason).toBe("denied");
+  });
+});
+
+describe("a refusal keeps the controls that can resolve it", () => {
+  it("an /edr denial is routed into the EDR plane, refusal visible meanwhile", () => {
+    invalidateSecurity("denied", "/edr");
+    const html = render("/edr");
+    // the plane is a lazy chunk: the refusal is on screen while it loads
+    expect(html).toContain("edr-access-notice-pending");
+    expect(html).toContain("route-denied");
+    expect(html).toContain("route-recheck-access");
+    // the page body is STILL not loaded
+    expect(html).not.toContain("EDR dashboard");
+    expect(loaded).not.toHaveBeenCalled();
+  });
+
+  it("the plane renders the refusal with the console and the picker around it", () => {
+    const html = renderToStaticMarkup(
+      <StaticRouter location="/edr/computers">
+        <EdrAccessNotice><PermissionNotice state="denied" /></EdrAccessNotice>
+      </StaticRouter>);
+    expect(html).toContain("edr-console-shell");
+    expect(html).toContain("edr-customer-pill");
+    expect(html).toContain("route-denied");
+    // and it opens on the refused destination, not a different one
+    expect(html).toContain('data-active-tab="computers"');
+  });
+
+  it("an XDR denial is unchanged — no EDR plane is mounted", () => {
+    invalidateSecurity("denied", "/xdr/incidents");
+    const html = render("/xdr/incidents");
+    expect(html).toContain("route-denied");
+    expect(html).not.toContain("edr-access-notice-pending");
+    expect(html).not.toContain("edr-console-shell");
+    expect(loaded).not.toHaveBeenCalled();
+  });
+});
