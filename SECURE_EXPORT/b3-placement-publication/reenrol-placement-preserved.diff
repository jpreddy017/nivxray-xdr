+async def _effective_placement(tenant_id: str, endpoint_id: str,
+                               intended: dict) -> dict:
+    """What the endpoint is ACTUALLY in, not what we just tried to give it.
+
+    Both assignments are guarded on "has no group yet", so a re-enrolling
+    computer keeps the group an administrator chose. Returning the INTENDED
+    placement then told the caller — and the enrolment response — that the
+    computer had moved into the default group when it had not.
+    """
+    row = await _db[store.ENDPOINTS].find_one(
+        {"tenant_id": tenant_id, "endpoint_id": endpoint_id},
+        {"_id": 0, "group_id": 1, "policy_id": 1}) or {}
+    return ({"group_id": row["group_id"], "policy_id": row.get("policy_id")}
+            if row.get("group_id") else intended)
+
+
 async def assign_default_placement(tenant_id: str, endpoint_id: str) -> dict:
     """Assigned at enrolment, and only if the endpoint has no placement yet."""
     placement = await ensure_default_placement(tenant_id)
@@ -273,7 +289,7 @@ async def assign_default_placement(tenant_id: str, endpoint_id: str) -> dict:
         {"$set": {**placement,
                   "placement_basis": "DEFAULT_AT_ENROLMENT",
                   "placement_at": _now().isoformat()}})
-    return placement
+    return await _effective_placement(tenant_id, endpoint_id, placement)
 
 
 async def assign_deployment_placement(tenant_id: str, endpoint_id: str,
@@ -298,7 +314,7 @@ async def assign_deployment_placement(tenant_id: str, endpoint_id: str,
                   "placement_basis": "CONNECTOR_DEPLOYMENT",
                   "deployment_id": deployment_id,
                   "placement_at": _now().isoformat()}})
-    return placement
