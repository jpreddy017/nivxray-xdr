+    # and policy an administrator chose for it, which can mean a weaker
+    # policy. Insert-only, exactly like the delivery record: a new endpoint
+    # is still placed at enrolment, an existing one keeps what it was given.
+    delivery.update({k: fields.pop(k) for k in
+                     ("group_id", "policy_id", "placement_basis",
+                      "placement_at", "deployment_id", "policy_source",
+                      "policy_assigned_at", "policy_assigned_by")})
     await db[ENDPOINTS].update_one(
         {"tenant_id": tenant_id, "endpoint_id": endpoint_id},
         {"$set": fields, "$setOnInsert": delivery}, upsert=True)
