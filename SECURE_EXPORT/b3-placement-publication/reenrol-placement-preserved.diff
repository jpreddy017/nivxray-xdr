diff --git a/.github/workflows/edr-enrolment-recovery-gate.yml b/.github/workflows/edr-enrolment-recovery-gate.yml
new file mode 100644
index 00000000..776c39cf
--- /dev/null
+++ b/.github/workflows/edr-enrolment-recovery-gate.yml
@@ -0,0 +1,132 @@
+name: EDR Enrolment Recovery Gate
+
+# What this gate exists to stop: a re-enrolment that silently costs the
+# endpoint something it already had. The delivery record was reset once
+# (P0-3) and fleet placement was reset again (this change), both by the same
+# mechanism — `$set` of a whole model whose fields default to None. These
+# suites assert the behaviour against a REAL database, not by reading the
+# source, so the next regression of that shape fails here instead of on a
+# customer's computer.
+#
+# Deliberately narrow: it runs the enrolment recovery suites and nothing
+# else. The existing RC4.x / RC5 gates only trigger for PRs targeting
+# main and feature/*, so a thin publish/* review branch had NO backend CI
+# at all — which is why this file exists.
+
+on:
+  push:
+    branches:
+      - publish/reenrol-placement-preserved
+      - engineering/reenrol-placement-preserved
+  pull_request:
+    paths:
+      - 'backend/edr_plane/enrollment/**'
+      - 'backend/edr_plane/contracts/identity.py'
+      - 'backend/routers/edr_enrollment.py'
+      - 'backend/routers/edr_onboarding.py'
+      - 'backend/tests/edr/test_p0_reenrol_placement_preserved.py'
+      - 'backend/tests/edr/test_p0_win_reenrol_recovery.py'
+      - '.github/workflows/edr-enrolment-recovery-gate.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: edr-enrolment-recovery-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  enrolment-recovery:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    services:
+      mongo:
+        image: mongo:6
+        ports: ["27017:27017"]
+
+    env:
+      MONGO_URL: mongodb://localhost:27017
+      DB_NAME: nivxray_ci_enrolment
+      ADMIN_EMAIL: "admin@nivxray.com"
+      ADMIN_PASSWORD: "ci-only-not-a-real-secret"
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+
+      - name: Set up Python 3.11
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+          cache: 'pip'
+
+      - name: Install minimal deps (no LLM stack needed for these gates)
+        working-directory: backend
+        run: |
+          python -m pip install --upgrade pip
+          grep -Ev "^(emergentintegrations|litellm)([=<>~ ]|$| @ )" \
+            requirements.txt > requirements-ci.txt
+          pip install -r requirements-ci.txt \
+            --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/
+
+      # ── the recovery contract ───────────────────────────────────────
+      - name: Gate · a REVOKED endpoint recovers without losing its past
+        working-directory: backend
+        run: >-
+          python -m pytest -p no:randomly -n 0 -q --no-header
+          tests/edr/test_p0_win_reenrol_recovery.py
+
+      - name: Gate · a recovery keeps the group, the policy and its provenance
+        working-directory: backend
+        run: >-
+          python -m pytest -p no:randomly -n 0 -q --no-header
+          tests/edr/test_p0_reenrol_placement_preserved.py
+
+      # The Gate 0 CI contract suite exists only on the full engineering
+      # tree, not on a thin publish/* review branch. Naming it
+      # unconditionally would fail this gate with "file or directory not
+      # found" on exactly the branch it was written for, so it is run when
+      # present and its absence is REPORTED rather than passed over.
+      - name: Gate · the Windows installer still refuses what it refuses
+        working-directory: backend
+        run: |
+          suites="tests/edr/test_p0_windows_reenrol_staging_race.py"
+          if [ -f tests/edr/test_b5_gap1_windows_gate0_ci_contract.py ]; then
+            suites="$suites tests/edr/test_b5_gap1_windows_gate0_ci_contract.py"
+          else
+            echo "NOTE: Gate 0 CI contract suite absent on this branch (thin publication branch) — not run"
+          fi
+          python -m pytest -p no:randomly -n 0 -q --no-header $suites
+
+      # ── the honest part: collection errors are BOUNDED, not hidden ──
+      # Much of tests/edr requires a live verified-session credential that
+      # CI does not hold. Those files fail at COLLECTION, which is easy to
+      # mistake for a passing suite. This step collects the whole directory
+      # and fails if a single collection error is anything other than that
+      # missing credential — so the known gap stays known and nothing new
+      # can hide inside it.
+      - name: Gate · every collection error is the known credential gap
+        working-directory: backend
+        run: |
+          set -o pipefail
+          COLUMNS=200 python -m pytest tests/edr --collect-only -q -p no:randomly \
+            -n 0 --continue-on-collection-errors 2>&1 | tee /tmp/collect.txt || true
+          python - <<'PY'
+          import sys
+          lines = open('/tmp/collect.txt').read().splitlines()
+          errors = sorted({l.strip() for l in lines if l.startswith('ERROR ')})
+          known = [l for l in errors if 'NIVXRAY_EXPORT_REQUIRED' in l or 'NIVXRAY_EX' in l]
+          unexplained = [l for l in errors if l not in known]
+          print(f"collection errors: {len(errors)}")
+          print(f"explained by the missing live-session credential: {len(known)}")
+          for line in unexplained:
+              print(f"UNEXPLAINED: {line}")
+          sys.exit(1 if unexplained else 0)
+          PY
+
+      - name: Verdict
+        run: 'echo "EDR ENROLMENT RECOVERY GATE: PASS"'
