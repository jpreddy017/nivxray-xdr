+def test_an_indeterminate_path_check_refuses_before_anything_is_created(lab):
+    """The same UNKNOWN during the configuration ancestry walk refuses before
+    the installer creates, enrols or registers anything."""
+    lab["host"].granted_path = {m1.FILE_WRITE_DATA: None}
+    with pytest.raises(m1.M1Error) as caught:
+        install(lab)
+    assert caught.value.code in ("CONFIG_ANCESTRY_UNSAFE", "CONFIG_ACL_UNSAFE")
+    assert lab["host"].calls == []
+    assert not lab["install"].exists()
+    assert not (lab["root"] / "config" / m1.OWNERSHIP_FILENAME).exists()
