+def test_both_renderings_of_a_descriptor_follow_the_same_rules():
+    """`descriptor_to_sddl` feeds AccessCheck and `_descriptor_to_sd` feeds
+    SetServiceObjectSecurity. They must not drift apart."""
+    source = (AGENT_DIR / "nivxforge_m1.py").read_text()
+    import ast
+    tree = ast.parse(source)
+    sddl = next(ast.get_source_segment(source, node) for node in ast.walk(tree)
+                if isinstance(node, ast.FunctionDef)
+                and node.name == "descriptor_to_sddl")
+    builder = next(ast.get_source_segment(source, node)
+                   for node in ast.walk(tree)
+                   if isinstance(node, ast.FunctionDef)
+                   and node.name == "_descriptor_to_sd")
+    for rule in ('ACCESS_DENIED_ACE_TYPE', 'INHERIT_ONLY_ACE',
+                 'map_generic(', 'mapping'):
+        assert rule in sddl and rule in builder, rule
