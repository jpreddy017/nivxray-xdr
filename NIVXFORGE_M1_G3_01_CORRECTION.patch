+def test_an_absent_token_is_indeterminate_not_a_denial(lab):
+    """A host that cannot build a context answers UNKNOWN for every right, so
+    the refusal lands at the FIRST gate that needs one — the configuration
+    ancestry — and nothing is created, enrolled or registered."""
+    lab["host"].context = None
+    verdict = m1.service_security_verdict(_descriptor(), lab["host"])
+    assert not verdict["safe"]
+    assert any("no token" in problem for problem in verdict["problems"])
+    with pytest.raises(m1.M1Error) as caught:
+        install(lab)
+    assert caught.value.code in ("CONFIG_ANCESTRY_UNSAFE", "CONFIG_ACL_UNSAFE")
+    assert lab["host"].calls == []
+    assert not lab["host"].started
