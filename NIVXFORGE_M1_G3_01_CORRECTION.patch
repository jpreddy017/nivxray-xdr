+# ══ G3-01 · the AccessCheck contract ═══════════════════════════════
+# The reviewer's finding: a raised native error with WinError 5 was read as a
+# VERIFIED access denial. The documented cause of ERROR_ACCESS_DENIED from
+# AccessCheck itself is a ClientToken without TOKEN_QUERY, which says nothing
+# about the descriptor. Reading it as "denied" reports a restrictive
+# descriptor on the strength of a broken call.
+
+ALL_WINERRORS = [0, 5, 6, 87, 122, 1008, 1338, 1346, -1, 2147942405]
+
+
+@pytest.mark.parametrize("winerror", ALL_WINERRORS)
+@pytest.mark.parametrize("status,granted", [(0, 0), (1, 0xFFFFFFFF), (1, 0),
+                                            (0, 0xFFFFFFFF), (None, None)])
+def test_an_api_failure_is_never_a_verified_denial(winerror, status, granted):
+    """ok=False is UNKNOWN for every error code and every residual output.
+    `False` must be unreachable when the call itself did not succeed."""
+    verdict = m1.access_check_verdict(False, status, granted,
+                                      m1.SERVICE_START)
+    assert verdict is None, (winerror, status, granted, verdict)
+    assert verdict is not False
+
+
+@pytest.mark.parametrize("ok", [False, 0, None, "", "True"])
+def test_only_a_literal_true_counts_as_a_successful_call(ok):
+    assert m1.access_check_verdict(ok, 1, m1.SERVICE_START,
+                                   m1.SERVICE_START) is None
+
+
+ACCESS_CONTRACT = [
+    # ok,   status, granted,              wanted,              expected
+    (True,  1,      m1.SERVICE_START,     m1.SERVICE_START,    True),
+    (True,  1,      m1.SERVICE_ALL_ACCESS, m1.SERVICE_START,   True),
+    (True,  0,      0,                    m1.SERVICE_START,    False),
+    (True,  1,      0,                    m1.SERVICE_START,    None),
+    (True,  1,      m1.SERVICE_STOP,      m1.SERVICE_START,    None),
+    (True,  0,      m1.SERVICE_START,     m1.SERVICE_START,    None),
+    (True,  None,   0,                    m1.SERVICE_START,    None),
+    (True,  1,      None,                 m1.SERVICE_START,    None),
+    (True,  "yes",  0,                    m1.SERVICE_START,    None),
+    (True,  1,      m1.SERVICE_START,     0,                   None),
+    (True,  1,      m1.SERVICE_START,     -4,                  None),
+    (True,  1,      0xFFFFFFFF,           m1.GENERIC_ALL,      None),
+    (False, 1,      m1.SERVICE_ALL_ACCESS, m1.SERVICE_START,   None),
+]
+
+
+@pytest.mark.parametrize("ok,status,granted,wanted,expected", ACCESS_CONTRACT)
+def test_the_access_check_contract_is_read_correctly(ok, status, granted,
+                                                     wanted, expected):
+    assert m1.access_check_verdict(ok, status, granted, wanted) is expected
+
