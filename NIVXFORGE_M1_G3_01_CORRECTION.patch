+def test_the_winerror_five_denial_branch_is_gone():
+    source = (AGENT_DIR / "nivxforge_m1.py").read_text()
+    assert "win32security.AccessCheck(" not in source, (
+        "pywin32 does not wrap AccessCheck; the call would raise "
+        "AttributeError and be swallowed as UNKNOWN on every real host")
+    assert 'winerror", 0) == 5' not in source
+    import ast
+    tree = ast.parse(source)
+    host = next(node for node in ast.walk(tree)
+                if isinstance(node, ast.ClassDef) and node.name == "WindowsHost")
+    body = next(ast.get_source_segment(source, node) for node in host.body
+                if isinstance(node, ast.FunctionDef)
+                and node.name == "access_check")
+    assert "return False" not in body, (
+        "the native wrapper must not decide a denial itself; only "
+        "access_check_verdict may, and only from a successful call")
+    native = next(ast.get_source_segment(source, node) for node in host.body
+                  if isinstance(node, ast.FunctionDef)
+                  and node.name == "_access_check_native")
+    assert "advapi32" in native and "AccessCheck" in native
+    assert "PRIVILEGE_SET" in native and "LocalFree" in native
+    assert "access_check_verdict(bool(ok)" in native
+
