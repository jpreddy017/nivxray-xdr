+def test_a_denial_is_only_reported_on_a_successful_call_with_status_false():
+    """The single shape that means DENIED: the API succeeded, AccessStatus is
+    FALSE and GrantedAccess is zero, as the API documents."""
+    denials = [(ok, status, granted)
+               for ok in (True, False, None, 0)
+               for status in (0, 1, None)
+               for granted in (0, 1, None)
+               if m1.access_check_verdict(ok, status, granted,
+                                          m1.SERVICE_START) is False]
+    assert denials == [(True, 0, 0)]
+
+
+def test_a_grant_requires_every_requested_right():
+    for right in m1.DANGEROUS_RIGHTS.values():
+        assert m1.access_check_verdict(True, 1, right, right) is True
+        assert m1.access_check_verdict(True, 1, right & ~right, right) is None
+
