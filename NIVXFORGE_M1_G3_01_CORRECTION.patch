+# ── how UNKNOWN reaches a refusal ──────────────────────────────────
+def test_an_indeterminate_service_check_leaves_the_service_disabled(lab):
+    """UNKNOWN -> token_access_verdict problem -> verdict unsafe ->
+    SERVICE_SD_UNSAFE -> the service is never authorised or started."""
+    lab["host"].granted = {m1.SERVICE_CHANGE_CONFIG: None}
+    with pytest.raises(m1.M1Error) as caught:
+        install(lab)
+    assert caught.value.code == "SERVICE_SD_UNSAFE"
+    assert "indeterminate" in str(caught.value)
+    assert lab["host"].service["start_type_code"] == m1.SERVICE_DISABLED
+    assert lab["host"].config_calls == []
+    assert not lab["host"].started
+
