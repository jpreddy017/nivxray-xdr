+def test_the_descriptor_is_rendered_with_generics_resolved_and_deny_first():
+    descriptor = _descriptor([
+        {"type": m1.ACCESS_ALLOWED_ACE_TYPE, "sid": "S-1-5-11",
+         "mask": m1.GENERIC_EXECUTE},
+        {"type": m1.ACCESS_DENIED_ACE_TYPE, "sid": "S-1-1-0",
+         "mask": m1.SERVICE_STOP}])
+    sddl = m1.descriptor_to_sddl(descriptor, m1.GENERIC_MAPPING)
+    assert sddl.startswith(f"O:{m1.SID_ADMINISTRATORS}"
+                           f"G:{m1.SID_ADMINISTRATORS}D:P")
+    assert sddl.index("(D;") < sddl.index("(A;"), "deny ACEs must come first"
+    assert "0x" in sddl and "GENERIC" not in sddl
+    resolved = m1.map_generic(m1.GENERIC_EXECUTE, m1.GENERIC_MAPPING)
+    assert f"(A;;0x{resolved:08x};;;S-1-5-11)" in sddl
