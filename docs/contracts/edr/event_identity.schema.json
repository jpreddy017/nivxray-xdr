{
  "$defs": {
    "EpistemicState": {
      "description": "Directive \u00a76. The six \u2014 and only six \u2014 states an evidence field\nmay resolve to.",
      "enum": [
        "OBSERVED",
        "NOT_OBSERVED",
        "NOT_COLLECTED",
        "NOT_SUPPORTED",
        "PARSER_FAILED",
        "UNKNOWN"
      ],
      "title": "EpistemicState",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Directive \u00a75 \u2014 every layer is additive and versioned.",
      "properties": {
        "analysis_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Version"
        },
        "detection_content_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Content Version"
        },
        "normalizer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalizer Version"
        },
        "parser_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Name"
        },
        "parser_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Version"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "raw_id in edr_raw_events. The immutable original.",
          "title": "Raw Ref"
        },
        "replay_generation": {
          "default": 0,
          "description": "0 = original ingest. Incremented per replay so a re-reasoned event never masquerades as a new one.",
          "title": "Replay Generation",
          "type": "integer"
        },
        "sensor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Version"
        },
        "source": {
          "description": "collector / sensor / adapter identity",
          "title": "Source",
          "type": "string"
        },
        "verdict_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict Version"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "nivxforge-edr/wave0/v1/event_identity.schema.json",
  "additionalProperties": false,
  "description": "Contract 6. Identity of one telemetry OCCURRENCE.\n\n`dedup_key` is the verbatim digest of the raw payload, so a replayed\nor re-delivered event can never be counted twice (the idempotency rule\nproven in P1.10a). `event_time` is when it happened on the endpoint;\n`ingest_time` is when we learned about it. Late telemetry is a normal\ncondition, not an error, so both are mandatory and separate.",
  "properties": {
    "activity_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "nivxforge_evidence": true,
      "title": "Activity Type"
    },
    "dedup_key": {
      "title": "Dedup Key",
      "type": "string"
    },
    "endpoint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "nivxforge_evidence": true,
      "title": "Endpoint Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_time": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "nivxforge_evidence": true,
      "title": "Event Time"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "field_state_reasons": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Human reason per absent field, e.g. 'CEF carries no parent-process field in either specification'. This is what the console renders after '\u2298 Not collected'.",
      "title": "Field State Reasons",
      "type": "object"
    },
    "field_states": {
      "additionalProperties": {
        "$ref": "#/$defs/EpistemicState"
      },
      "description": "Epistemic state per evidence field. Mandatory for any evidence field that is null.",
      "title": "Field States",
      "type": "object"
    },
    "ingest_time": {
      "title": "Ingest Time",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "raw_id of the immutable original in edr_raw_events",
      "nivxforge_evidence": true,
      "title": "Raw Ref"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "ingest_time",
    "event_type",
    "dedup_key"
  ],
  "title": "EventIdentity",
  "type": "object",
  "x-nivxforge-contract": "event_identity",
  "x-nivxforge-epistemic-states": [
    "OBSERVED",
    "NOT_OBSERVED",
    "NOT_COLLECTED",
    "NOT_SUPPORTED",
    "PARSER_FAILED",
    "UNKNOWN"
  ],
  "x-nivxforge-evidence-fields": [
    "endpoint_id",
    "event_time",
    "activity_type",
    "raw_ref"
  ]
}
