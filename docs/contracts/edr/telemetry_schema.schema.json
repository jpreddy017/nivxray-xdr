        "RESPONSE",
        "DETECTION",
        "SYSTEM"
      ],
      "title": "ActivityType",
      "type": "string"
    },
    "EpistemicState": {
      "description": "Directive \u00a76. The six \u2014 and only six \u2014 states an evidence field\nmay resolve to.",
      "enum": [
        "OBSERVED",
        "NOT_OBSERVED",
        "NOT_COLLECTED",
        "NOT_SUPPORTED",
        "PARSER_FAILED",
        "UNKNOWN"
      ],
      "title": "EpistemicState",
      "type": "string"
    },
    "FileIdentity": {
      "additionalProperties": false,
      "description": "Contract 4. Content identity is the SHA-256; path identity is not\nidentity at all, because one file appears under many names.\n\n`content_digest_available` is explicit because the current substrate\nhonestly cannot hash file content (see the truth audit): a SHA-256\nquery today degrades to a name query, and the API says so rather than\npretending to match on hash.",
      "properties": {
        "content_digest_available": {
          "default": false,
          "title": "Content Digest Available",
          "type": "boolean"
        },
        "disposition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CLEAN | MALICIOUS | UNKNOWN | UNAVAILABLE \u2014 never defaulted to CLEAN",
          "nivxforge_evidence": true,
          "title": "Disposition"
        },
        "extension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
