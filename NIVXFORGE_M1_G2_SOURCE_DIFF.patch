+def test_each_dangerous_right_is_probed_individually(lab):
+    seen = []
+    host = lab["host"]
+    original = host.access_check
+
+    def recording(descriptor, context, right, mapping):
+        seen.append(right)
+        return original(descriptor, context, right, mapping)
+
+    host.access_check = recording
+    m1.service_security_verdict(_descriptor(), host)
+    assert sorted(seen) == sorted(m1.DANGEROUS_RIGHTS.values())
+    assert m1.SERVICE_ALL_ACCESS not in seen
