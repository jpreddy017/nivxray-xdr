+    ("S-1-5-4", m1.GENERIC_ALL),
+    ("S-1-1-0", m1.GENERIC_WRITE),               # Everyone
+    ("S-1-5-32-545", m1.GENERIC_EXECUTE),        # Users
+    ("S-1-5-11", m1.WRITE_DAC),
+    ("S-1-5-21-1-2-3-1001", m1.SERVICE_START),   # unrelated individual user
+    ("S-1-5-21-1-2-3-1001", m1.GENERIC_ALL),
