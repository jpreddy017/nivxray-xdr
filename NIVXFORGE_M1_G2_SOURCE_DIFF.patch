+def test_an_acl_walk_for_one_account_would_miss_a_grant_to_another(lab):
+    """The narrow, documented limitation retained by Amendment A2: a
+    single-trustee query reflects only the trustee supplied. No acceptance
+    decision depends on this; the acceptance criterion is that the real
+    mechanism REJECTS the case, which the test above asserts."""
+    descriptor = _descriptor([{"type": m1.ACCESS_ALLOWED_ACE_TYPE,
+                               "sid": "S-1-5-21-1-2-3-1001",
+                               "mask": m1.SERVICE_START}])
+    single_trustee = lab["host"].access_check(
+        descriptor, {"sids": ["S-1-5-21-1-2-3-9999"]}, m1.SERVICE_START,
+        m1.GENERIC_MAPPING)
+    assert single_trustee is False            # not reflected for that trustee
+    assert not m1.ace_inspection(descriptor) == []   # but ACE inspection sees it
