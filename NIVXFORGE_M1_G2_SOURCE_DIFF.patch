+"""M1 clean installer — portable regressions, negative controls and races.
+
+PORTABLE EVIDENCE ONLY. These tests exercise OUR logic: ordering, refusal
+paths, record states, mask resolution and trustee rules. They do NOT and
+cannot establish that Windows behaves as documented. Every Win32 behaviour
+(`CreateDirectoryW` + SD, `MoveFileEx` without REPLACE_EXISTING, AccessCheck,
+service SD application, pending deletion, process-exit evidence) remains a
+native obligation listed in the G4 checklist.
+
+The FakeHost below simulates the OS surface. It never answers a security
+question with a hardcoded "safe": every verdict the tests assert comes from
+the real implementation in `nivxforge_m1.py` reading simulated state.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+AGENT_DIR = (Path(__file__).resolve().parents[3]
+             / "agents" / "nivxforge-windows")
+sys.path.insert(0, str(AGENT_DIR))
+
+import nivxforge_m1 as m1                                   # noqa: E402
+import nivxforge_sensor as sensor                           # noqa: E402
+
+FORBIDDEN_MODULES = ("nivxforge_transaction", "nivxforge_scm_worker")
+
+
+# ── the simulated OS surface ───────────────────────────────────────
+class FakeHost:
+    def __init__(self, root: Path):
+        self.root = root
+        self.service: dict | None = None
+        self.service_state = m1.PROBE_ABSENT
+        self.service_detail = "ERROR_SERVICE_DOES_NOT_EXIST"
+        self.descriptor: dict | None = None
+        self.started = False
+        self.deleted = False
+        self.stop_result = "STOPPED"
+        self.delete_result = "DELETED"
+        self.exit_proof: bool | None = True
+        self.image_verdict = "MATCH"
+        self.task = (m1.PROBE_ABSENT, "")
+        self.workers: list | None = []
+        self.unsafe_dirs: set[str] = set()
+        self.unreadable_dirs: set[str] = set()
+        self.reparse: set[str] = set()
+        self.lock_taken = False
+        self.calls: list[str] = []
+        self.context = {"sids": list(m1.REQUIRED_CONTEXT_SIDS)}
+        self.granted: dict[int, bool | None] = {}
+        self.create_raises: dict[str, str] = {}
+        self.crash_after: str | None = None
+
+    # time / paths
+    def now_utc(self):
+        return "2026-06-01T00:00:00Z"
+
+    def path_ancestry(self, path):
+        path = Path(path)
+        return list(reversed([path, *path.parents]))[1:]
+
+    def is_reparse_point(self, path):
+        return str(path) in self.reparse
+
+    def path_exists(self, path):
+        return Path(path).exists()
+
+    def is_file(self, path):
+        return Path(path).is_file()
+
+    def is_dir(self, path):
+        return Path(path).is_dir()
+
+    def read_bytes(self, path):
+        return Path(path).read_bytes()
+
+    def write_new_file(self, path, data):
+        try:
+            handle = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        except FileExistsError:
+            raise m1.M1Error("ALREADY_EXISTS", str(path)) from None
+        try:
+            os.write(handle, data)
+        finally:
+            os.close(handle)
+
+    def replace_file(self, path, data):
+        temporary = Path(f"{path}.tmp")
+        temporary.write_bytes(data)
+        os.replace(temporary, path)
+
+    def copy_payload(self, bundle_root, dest_root, manifest):
+        for member in manifest:
+            target = Path(dest_root) / member
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes((Path(bundle_root) / member).read_bytes())
+
+    def create_directory_protected(self, path):
+        self.calls.append(f"mkdir:{path}")
+        if str(path) in self.create_raises:
+            raise m1.M1Error(self.create_raises[str(path)], str(path))
+        try:
+            os.mkdir(path)
+        except FileExistsError:
+            raise m1.M1Error("ALREADY_EXISTS", str(path)) from None
+        if self.crash_after == f"mkdir:{path}":
+            raise KeyboardInterrupt("injected crash")
+
+    def directory_security(self, path):
+        if str(path) in self.unreadable_dirs:
+            return None
+        return {"nonadmin_writable": str(path) in self.unsafe_dirs}
+
+    def file_security(self, path):
+        return self.directory_security(path)
+
+    # SCM
+    def service_lookup(self, name):
+        return self.service_state, self.service_detail
+
+    def scheduled_task_lookup(self, name):
+        return self.task
+
+    def worker_processes(self):
+        return self.workers
+
+    def service_create(self, name, bin_path):
+        self.calls.append(f"create:{name}")
+        self.service = {"bin_path": bin_path, "account": "LocalSystem",
+                        "start_type": "AUTO_START", "pid": 4242}
+        self.service_state = m1.PROBE_PRESENT
+        if self.crash_after == f"create:{name}":
+            raise KeyboardInterrupt("injected crash")
+
+    def service_qc(self, name):
+        return self.service
+
+    def service_set_security(self, name, descriptor):
+        self.calls.append("set_sd")
+        if self.descriptor is None:
+            self.descriptor = descriptor
+
+    def service_security(self, name):
+        return self.descriptor
+
+    def service_start(self, name):
+        self.calls.append("start")
+        self.started = True
+
+    def service_stop(self, name):
+        self.calls.append("stop")
+        return self.stop_result
+
+    def service_delete(self, name):
+        self.calls.append("delete")
+        if self.delete_result == "DELETED":
+            self.service_state = m1.PROBE_ABSENT
+            self.deleted = True
+        return self.delete_result
+
+    def process_exited(self, pid):
+        return self.exit_proof
+
+    def verify_running_image(self, name, expected):
+        return self.image_verdict
+
+    # security evaluation
+    def access_context(self):
+        return self.context
+
+    def access_check(self, descriptor, context, right, mapping):
+        """Simulated effective access: resolve every allow ACE whose trustee
+        is in the supplied context and report whether `right` is granted."""
+        if right in self.granted:
+            return self.granted[right]
+        if descriptor.get("dacl") is None:
+            return True                       # NULL DACL grants everything
+        effective = 0
+        for ace in descriptor["dacl"]:
+            if ace.get("type") != m1.ACCESS_ALLOWED_ACE_TYPE:
+                continue
+            if ace.get("sid") in context.get("sids", ()):
+                mask = ace.get("mask")
+                if isinstance(mask, int):
+                    effective |= m1.map_generic(mask)
+        return bool(effective & right)
+
+    def exclusive_lock(self):
+        return _FakeLock(self)
+
+    def read_identity(self, state_dir):
+        path = Path(state_dir) / "identity.json"
+        return json.loads(path.read_text()) if path.is_file() else None
+
+    def read_attempt_marker(self, state_dir):
+        return sensor.read_attempt_marker(Path(state_dir))
+
+    def close_attempt_marker(self, state_dir, outcome, evidence):
+        return sensor.close_attempt_marker(outcome, evidence,
+                                           state_dir=Path(state_dir))
+
+
+class _FakeLock:
+    def __init__(self, host):
+        self.host = host
+
+    def __enter__(self):
+        if self.host.lock_taken:
+            return None
+        self.host.lock_taken = True
+        return self
+
+    def __exit__(self, *exc):
+        self.host.lock_taken = False
+        return False
+
