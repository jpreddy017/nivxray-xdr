+    ("S-1-5-32-551", m1.GENERIC_EXECUTE),
+    ("S-1-5-21-1-2-3-2001", m1.GENERIC_ALL),     # nested group
+    ("S-1-5-21-1-2-3-2001", m1.WRITE_DAC),
