+    (_descriptor([{"type": 9, "sid": "S-1-5-11", "mask": 1}]), "ACE type"),
+    (_descriptor([{"type": 0, "sid": "not-a-sid", "mask": 1}]), "trustee"),
+    (_descriptor([{"type": 0, "sid": "S-1-5-11", "mask": "all"}]), "mask"),
+    (_descriptor(protected=False), "protected"),
+    (_descriptor(malformed=True), "malformed"),
+    (_descriptor(group=None), "owner or group"),
