+def test_packaging_declares_every_required_module():
+    setup = (AGENT_DIR / "nivxforge_setup.py").read_text()
+    build = (AGENT_DIR / "build" / "build_windows_installer.ps1").read_text()
+    for module in ("nivxforge_journal", "nivxforge_m1", "nivxforge_sensor",
+                   "nivxforge_exclusions", "nivxforge_delivery_counters",
+                   "nivxforge_content_acquisition", "sqlite3", "_sqlite3"):
+        assert module in setup, f"{module} missing from _REQUIRED_BUNDLED"
+    for source in ("nivxforge_journal.py", "nivxforge_m1.py",
+                   "nivxforge_sensor.py", "nivxforge_setup.py"):
+        assert source in build, f"{source} missing from the required sources"
+    for hidden in ("'nivxforge_journal'", "'nivxforge_m1'", "'sqlite3'"):
+        assert hidden in build, f"{hidden} missing from --hidden-import"
+
