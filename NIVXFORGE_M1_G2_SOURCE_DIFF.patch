+@pytest.mark.parametrize("sid,mask", DANGEROUS_CASES)
+def test_dangerous_rights_for_any_other_trustee_prevent_activation(lab, sid,
+                                                                   mask):
+    descriptor = _descriptor([{"type": m1.ACCESS_ALLOWED_ACE_TYPE,
+                               "sid": sid, "mask": mask}])
+    verdict = m1.service_security_verdict(descriptor, lab["host"])
+    assert not verdict["safe"]
+    lab["host"].descriptor = descriptor
+    with pytest.raises(m1.M1Error) as caught:
+        install(lab)
+    assert caught.value.code == "SERVICE_SD_UNSAFE"
+    assert not lab["host"].started, "the service must never be started"
