+# ── 7 · enrollment lifecycle (R3/B5) ───────────────────────────────
+def _transport(monkeypatch, behaviour):
+    calls = {"n": 0}
+
+    class Fake:
+        def request(self, api, path, method, body, headers, attempts=2):
+            for attempt in range(1, max(1, attempts) + 1):
+                calls["n"] += 1
+                result = behaviour(calls["n"])
+                if isinstance(result, Exception):
+                    if attempt >= max(1, attempts):
+                        raise OSError("transport: lost")
+                    continue
+                return result
+            raise OSError("transport: unreachable")
+
+    monkeypatch.setattr(sensor, "TRANSPORT", Fake())
+    return calls
+
