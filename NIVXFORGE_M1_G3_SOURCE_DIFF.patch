+# ── 13 · P0-1 · the native methods are implemented ─────────────────
+def test_no_security_critical_host_method_is_a_stub():
+    source = (AGENT_DIR / "nivxforge_m1.py").read_text()
+    assert "NOT_IMPLEMENTED_NATIVE" not in source, (
+        "a security-critical host method is still a declared stub")
+    import ast
+    tree = ast.parse(source)
+    host = next(node for node in ast.walk(tree)
+                if isinstance(node, ast.ClassDef) and node.name == "WindowsHost")
+    bodies = {node.name: ast.get_source_segment(source, node)
+              for node in host.body if isinstance(node, ast.FunctionDef)}
+    for name, api in SECURITY_CRITICAL.items():
+        assert name in bodies, f"{name} is missing from WindowsHost"
+        body = bodies[name]
+        assert api in body or api in source, f"{name} does not call {api}"
+        assert "return None\n" != body.strip().splitlines()[-1].strip() + "\n" \
+            or len(body.strip().splitlines()) > 3, f"{name} is a bare stub"
+
