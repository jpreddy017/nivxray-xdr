+        return None
+    if before == "ABSENT":
+        return True
+    if now is None:
+        return None
+    if now == "ABSENT":
+        return True
+    if not isinstance(before, dict) or not isinstance(now, dict):
+        return None
+    if before.get("created") is None or now.get("created") is None:
+        return None
+    return now["created"] != before["created"]
