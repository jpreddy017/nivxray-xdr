+    owner = descriptor.get("owner")
+    if owner not in APPROVED_PATH_OWNERS:
+        problems.append(f"owner {owner!r} is not SYSTEM, Administrators or "
+                        "TrustedInstaller, and an owner holds WRITE_DAC "
+                        "implicitly")
