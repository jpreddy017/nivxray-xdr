+# ── 16 · P1-4 · filesystem security validation ─────────────────────
+def _path_sd(aces=(), **overrides):
+    descriptor = {"owner": m1.SID_ADMINISTRATORS,
+                  "group": m1.SID_ADMINISTRATORS, "protected": True,
+                  "dacl_present": True,
+                  "dacl": [{"type": 0, "flags": 0, "sid": m1.SID_LOCAL_SYSTEM,
+                            "mask": m1.FILE_ALL_ACCESS},
+                           {"type": 0, "flags": 0, "sid": m1.SID_ADMINISTRATORS,
+                            "mask": m1.FILE_ALL_ACCESS}, *aces]}
+    descriptor.update(overrides)
+    return descriptor
+
