+# ── 18 · audit · objects M1 creates carry an explicit owner ────────
+def test_created_objects_carry_an_explicit_administrators_owner():
+    """A directory or file created without `O:BA` is owned by the creating
+    administrator's USER account, and an owner holds WRITE_DAC implicitly,
+    which the owned-role verdict refuses. Without this the install could not
+    complete on any default Windows 11 host."""
+    assert m1._PROTECTED_DIR_SDDL.startswith("O:BAG:BA")
+    assert m1._PROTECTED_FILE_SDDL.startswith("O:BAG:BA")
+    for sddl in (m1._PROTECTED_DIR_SDDL, m1._PROTECTED_FILE_SDDL):
+        assert "D:PAI(" in sddl, "the DACL must be PROTECTED"
+        assert "FA;;;SY" in sddl and "FA;;;BA" in sddl
+        assert ";;;AU" not in sddl and ";;;WD" not in sddl
+    source = (AGENT_DIR / "nivxforge_m1.py").read_text()
+    assert "_PROTECTED_DIR_SDDL, win32security.SDDL_REVISION_1" in source
+    copy = source.split("def copy_payload")[1].split("\n    def ")[0]
+    assert "_apply_protected_sd(target)" in copy
+
