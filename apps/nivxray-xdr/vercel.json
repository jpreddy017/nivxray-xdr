{
  "installCommand": "yarn install --production=false",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "framework": null,
  "build": {
    "env": {
      "NPM_CONFIG_PRODUCTION": "false",
      "YARN_PRODUCTION": "false"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "xdr.nivxforge.com"
        }
      ],
      "destination": "/xdr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
