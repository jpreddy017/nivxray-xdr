  },
  "icon_system": {
    "library": "lucide-react",
    "stroke_width": 1.5,
    "size_scale": {
      "micro": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px"
    },
    "sidebar_section_icons": {
      "Workspace": "LayoutGrid",
      "Operations": "Activity",
      "Investigations": "ShieldAlert",
      "Intelligence": "Globe",
      "Exposure": "Radar",
      "Data": "Database",
      "Administration": "Settings"
    }
  },
  "component_primitives": {
    "Button": {
      "variants": ["primary", "secondary", "ghost", "destructive", "outline"],
      "sizes": ["xs (24px)", "sm (28px)", "md (32px)", "lg (40px)"],
      "states": ["default", "hover", "active", "focus-visible", "disabled", "loading"],
      "rule": "Every button must have a subtle focus-visible ring (`ring-1 ring-[#5cc0a5]`) and active scale transition (`active:scale-[0.98]`). Mandatory data-testid."
    },
    "Table": {
      "style": "Dense Enterprise Data Grid",
      "header_height": "32px",
      "row_height": "32px",
      "font_family": "Monospace for hashes/IPs/timestamps, Geist for labels",
      "features": ["sticky header", "column resize handles", "checkbox bulk select", "sort indicators", "row action menu"]
    },
    "DeviceTrajectoryCanvas": {
      "panes": ["Left inventory (240px)", "Center Canvas + SVG timeline", "Right Activity Details (320px)"],
      "render_mode": "Canvas for grid + SVG for interactive process nodes and curved edges"
    }
  },
  "layout_system": {
    "sidebar_width_expanded": "240px",
    "sidebar_width_collapsed": "56px",
    "topbar_height": "48px",
    "gutter": "16px",
    "content_max_width": "none (full viewport width utilization)"
  },
  "instructions_to_main_agent": [
    "Step 1: Create `src/styles/tokens.css` with exact root CSS variables matching design_tokens.",
    "Step 2: Create reusable component primitives in `src/components/ui/` (Button, Tag, Badge, Table, Modal, Tooltip, Input, Select, honest state containers).",
    "Step 3: Refactor `XdrShell.jsx` topbar and left navigation using new design system tokens and icons.",
    "Step 4: Upgrade `XdrIncidentsPage.jsx` and `XdrIncidentDetailPage.jsx` to enterprise data density tables and multi-tab layouts.",
    "Step 5: Apply honest-state visual grammar (Not Connected / No Matching Evidence / Not Observed) across all 6 domain pages and integrations.",
    "Step 6: Upgrade Device Trajectory 3-pane canvas and Admin pages."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Dark SOC Console Aesthetic ONLY. Do not introduce light mode or colorful consumer gradients.",
    "All interactive and key informational elements MUST include `data-testid` attribute (e.g. `data-testid='incidents-table-row-0'`).",
    "Never show generic empty states. Always render an authoritative honest state from the grammar.",
    "Monospace fonts ('JetBrains Mono' / 'IBM Plex Mono') MUST be used for IP addresses, hashes, command lines, timestamps, and process IDs."
  ]
}
