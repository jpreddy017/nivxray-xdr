{
  "design_system_name": "NivX Machines SOC Enterprise Design System",
  "version": "1.0.0",
  "brand_identity": {
    "name": "NivX Machines",
    "product": "NivXRay XDR",
    "theme_posture": "Dark Enterprise SOC Console",
    "brand_colors": {
      "mint_gradient_start": "#5cc0a5",
      "mint_gradient_end": "#3b8b75",
      "orange_spark_accent": "#e27e5d"
    },
    "mark_svg_spec": "<svg viewBox='0 0 24 24' fill='none'><path d='M4 4h4.5l7 11.5V4H20v16h-4.5l-7-11.5V20H4V4z' fill='url(#nivx-grad)'/><path d='M16.5 4.5l3.5 3.5' stroke='#e27e5d' strokeWidth='2' strokeLinecap='round'/><defs><linearGradient id='nivx-grad' x1='4' y1='4' x2='20' y2='20'><stop offset='0%' stopColor='#5cc0a5'/><stop offset='100%' stopColor='#3b8b75'/></linearGradient></defs></svg>"
  },
  "typography": {
    "font_family_pairings": {
      "ui_display_and_body": "Geist, 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "code_data_and_mono": "'JetBrains Mono', 'IBM Plex Mono', 'Berkeley Mono', monospace"
    },
    "scale": {
      "text-xs": "11px / 16px (0.6875rem)",
      "text-sm": "12px / 18px (0.75rem)",
      "text-base": "13px / 20px (0.8125rem)",
      "text-md": "14px / 22px (0.875rem)",
      "text-lg": "16px / 24px (1rem)",
      "text-xl": "18px / 28px (1.125rem)",
      "text-2xl": "22px / 32px (1.375rem)",
      "text-3xl": "28px / 38px (1.75rem)"
    },
    "font_weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letter_spacing": {
      "tight": "-0.015em",
      "normal": "0em",
      "mono_data": "-0.02em",
      "uppercase_label": "0.08em"
    }
  },
