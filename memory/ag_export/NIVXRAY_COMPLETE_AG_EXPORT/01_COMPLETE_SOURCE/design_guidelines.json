    "honest_state_grammar": {
      "NOT_OBSERVED": {
        "badge_bg": "rgba(100, 116, 139, 0.1)",
        "border": "#334155",
        "text": "#94a3b8",
        "icon": "EyeOff",
        "hatch_pattern": "repeating-linear-gradient(45deg, transparent, transparent 6px, rgba(148, 163, 184, 0.05) 6px, rgba(148, 163, 184, 0.05) 12px)",
        "description": "Telemetry source actively scanned; zero telemetry matching filter recorded in requested window."
      },
      "NOT_ESTABLISHED": {
        "badge_bg": "rgba(234, 179, 8, 0.1)",
        "border": "rgba(234, 179, 8, 0.3)",
        "text": "#eab308",
        "icon": "Clock",
        "hatch_pattern": "dotted-border",
        "description": "Telemetry pipeline initializing or pending sync handshake from tenant edge sensor."
      },
      "NOT_AVAILABLE": {
        "badge_bg": "rgba(168, 85, 247, 0.1)",
        "border": "rgba(168, 85, 247, 0.3)",
        "text": "#a855f7",
        "icon": "ShieldAlert",
        "hatch_pattern": "none",
        "description": "Capability requires elevated tenant license tier or explicitly disabled by security policy."
      },
      "NOT_CONNECTED": {
        "badge_bg": "rgba(239, 68, 68, 0.1)",
        "border": "rgba(239, 68, 68, 0.3)",
        "text": "#f87171",
        "icon": "Unplug",
        "hatch_pattern": "dashed-border",
        "description": "Telemetry integration unconfigured or API credentials expired."
      },
      "NO_MATCHING_EVIDENCE": {
        "badge_bg": "rgba(56, 189, 248, 0.08)",
        "border": "rgba(56, 189, 248, 0.25)",
        "text": "#38bdf8",
        "icon": "SearchX",
        "hatch_pattern": "none",
        "description": "Investigation executed deterministically across all connected telemetry nodes with zero positive IOC matches."
      },
      "ERROR": {
        "badge_bg": "rgba(239, 68, 68, 0.2)",
        "border": "#ef4444",
        "text": "#ef4444",
        "icon": "AlertTriangle",
        "hatch_pattern": "solid-alert",
        "description": "Backend execution fault or authoritative API transport timeout."
      }
    },
    "elevation_and_shadows": {
      "flat": "none",
      "card": "0 1px 3px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.04)",
      "popover": "0 8px 24px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06)",
      "modal": "0 20px 48px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.08)"
    },
    "spacing_scale": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px"
    },
    "border_radii": {
      "sharp": "0px",
      "subtle": "2px",
      "standard": "4px",
      "rounded": "6px",
      "pill": "9999px"
    },
    "z_index_scale": {
      "base": 0,
      "panel": 10,
      "sticky_header": 20,
      "popover_dropdown": 30,
      "drawer_slideover": 40,
      "modal_overlay": 50,
      "toast_notification": 60,
      "tooltip": 70
