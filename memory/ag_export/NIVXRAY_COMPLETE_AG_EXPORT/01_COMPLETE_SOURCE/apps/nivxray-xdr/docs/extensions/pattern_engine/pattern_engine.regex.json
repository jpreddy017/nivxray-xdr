  "output_schema": { "observation": "object", "provenance": "object" },
  "health_check": { "kind": "internal", "interval_seconds": 3600 },
  "lifecycle": "ENABLED",
  "adapter_status": "AVAILABLE",
  "risk": "low",
  "execution_mode": "sync"
}
