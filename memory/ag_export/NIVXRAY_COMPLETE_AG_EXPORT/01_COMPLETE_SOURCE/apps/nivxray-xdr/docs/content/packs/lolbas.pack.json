      "network_behavior": "Outbound HTTPS to rare domains; encoded body.",
      "file_behavior": "Writes to %TEMP%, %APPDATA%, %PROGRAMDATA%.",
      "registry_behavior": "May set HKCU\\...\\Run for persistence.",
      "attack": ["T1059.001", "T1027", "T1105", "T1547.001"],
      "severity": "high",
      "confidence": "high",
      "detection_rule_ids": ["encoded_powershell", "office_child_process"],
      "hunt_queries": {
        "sigma": "See sigma/generic/encoded-powershell.yml (regenerated)",
        "kql":   "DeviceProcessEvents | where FileName == 'powershell.exe' and (ProcessCommandLine contains '-EncodedCommand' or ProcessCommandLine contains '-enc ')"
      },
      "response_recommendations": ["die_decode", "process_tree",
                                                    "hunt_commandline", "collect_endpoint_evidence",
                                                    "isolate_endpoint"]
    },
