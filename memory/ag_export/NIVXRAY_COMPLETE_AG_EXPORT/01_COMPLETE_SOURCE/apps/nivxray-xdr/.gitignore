# --- Node / build outputs -------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/

# --- Env files ------------------------------------------------------
# .env is the public build-time config that Vercel needs, so we
# commit it.  Local overrides (.env.local, .env.*.local) never are.
.env.local
.env.*.local

# --- Logs -----------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / OS scratch --------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Test / coverage ------------------------------------------------
coverage/
.nyc_output/
.eslintcache

# --- Vercel local artefacts -----------------------------------------
.vercel/
