[
  {"id":"proc_creation_win_susp_encoded_pshell","title":"Suspicious Encoded PowerShell Command Line","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth (Nextron Systems)","created":"2019-01-16","modified":"2023-03-05","level":"high","status":"stable","description":"Detects suspicious PowerShell invocation command parameters (encoded command).","tags":["attack.execution","attack.t1059.001","attack.defense_evasion","attack.t1027"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\powershell.exe","CommandLine|contains":[" -e ","-enc ","-EncodedCommand"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_regsvr32_squiblydoo","title":"Regsvr32 Remote Scriptlet Load (Squiblydoo)","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Nikita Nazarov, Florian Roth","created":"2019-10-25","modified":"2023-02-10","level":"high","status":"stable","description":"Detects regsvr32 loading a remote scriptlet (Squiblydoo).","tags":["attack.defense_evasion","attack.t1218.010"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\regsvr32.exe","CommandLine|contains":["/i:http","/i:ftp","scrobj.dll"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_mshta_remote_hta","title":"Mshta Remote HTA Execution","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2019-01-25","modified":"2023-01-05","level":"high","status":"stable","description":"Detects mshta.exe loading a remote HTA file.","tags":["attack.defense_evasion","attack.execution","attack.t1218.005"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\mshta.exe","CommandLine|contains":["http://","https://"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_rundll32_user_writable","title":"Rundll32 Loading DLL From User-Writable Path","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2018-06-20","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects rundll32.exe loading a DLL from a user-writable path (Public/Temp/AppData).","tags":["attack.defense_evasion","attack.t1218.011"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\rundll32.exe","CommandLine|contains":["\\Users\\Public\\","\\Windows\\Temp\\","\\AppData\\","\\ProgramData\\"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_certutil_urlcache","title":"Certutil Download With URLCache","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2018-07-24","modified":"2023-03-05","level":"high","status":"stable","description":"Detects certutil.exe downloading files using -urlcache.","tags":["attack.command_and_control","attack.t1105"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\certutil.exe","CommandLine|contains":["urlcache","-split","-f "]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_bitsadmin_download","title":"Bitsadmin Download","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Michael Haag","created":"2019-01-16","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects bitsadmin.exe used to transfer files.","tags":["attack.command_and_control","attack.t1197","attack.t1105"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\bitsadmin.exe","CommandLine|contains":["/transfer","/addfile"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_office_spawns_shell","title":"Microsoft Office Product Spawning Command Shell","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Michael Haag, Florian Roth","created":"2018-04-06","modified":"2023-03-05","level":"high","status":"stable","description":"Detects office products spawning cmd.exe or powershell.exe (phishing macro pattern).","tags":["attack.execution","attack.t1204.002","attack.initial_access","attack.t1566.001"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection_parent":{"ParentImage|endswith":["\\winword.exe","\\excel.exe","\\powerpnt.exe","\\outlook.exe","\\onenote.exe"]},"selection_child":{"Image|endswith":["\\cmd.exe","\\powershell.exe","\\wscript.exe","\\cscript.exe","\\mshta.exe","\\regsvr32.exe","\\rundll32.exe"]},"condition":"selection_parent and selection_child"},"rule_type":"parent_child"},
  {"id":"proc_creation_win_wmic_process_call","title":"WMIC Process Call Create","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2019-01-16","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects wmic.exe process call create — lateral execution.","tags":["attack.execution","attack.t1047","attack.lateral_movement"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\wmic.exe","CommandLine|contains":["process call create","process create call"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_schtasks_persistence","title":"Schtasks Persistence Creation","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2018-11-30","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects schtasks.exe creating a scheduled task (persistence).","tags":["attack.persistence","attack.t1053.005"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\schtasks.exe","CommandLine|contains":["/create"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"proc_creation_win_msiexec_remote","title":"Msiexec Remote MSI Install","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2019-04-17","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects msiexec fetching remote MSI packages.","tags":["attack.defense_evasion","attack.t1218.007"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection":{"Image|endswith":"\\msiexec.exe","CommandLine|contains":["http://","https://"]},"condition":"selection"},"rule_type":"process_creation"},
  {"id":"net_dns_susp_tld","title":"Suspicious DNS Query to Uncommon TLDs","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/network/dns/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2019-05-15","modified":"2023-01-05","level":"low","status":"stable","description":"Detects DNS queries to uncommon TLDs frequently used by malware C2.","tags":["attack.command_and_control","attack.t1071.004"],"logsource":{"category":"dns","product":"windows"},"detection":{"selection":{"QueryName|endswith":[".top",".xyz",".club",".zip",".click",".gq"]},"condition":"selection"},"rule_type":"field_match"},
  {"id":"net_http_susp_ua","title":"Suspicious User-Agent Strings","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/network/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2019-05-15","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects suspicious User-Agents used by known malware and post-exploitation tools.","tags":["attack.command_and_control","attack.t1071.001"],"logsource":{"category":"proxy"},"detection":{"selection":{"c-useragent|contains":["Empire","Meterpreter","Cobalt","BITSAdmin","curl","wget"]},"condition":"selection"},"rule_type":"regex"},
  {"id":"win_auth_brute_force","title":"Multiple Failed Logins Followed By Success (Brute Force)","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2017-01-10","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects password brute-force followed by successful auth for the same user.","tags":["attack.credential_access","attack.t1110"],"logsource":{"product":"windows","service":"security"},"detection":{"selection_fail":{"EventID":4625},"selection_ok":{"EventID":4624},"timeframe":"10m","threshold":10,"condition":"selection_fail | count() by TargetUserName >= 10 followed by selection_ok"},"rule_type":"threshold"},
  {"id":"win_persistence_registry_run_key","title":"Registry Run Key Set To User-Writable Path","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/","license":"DRL 1.1","license_verified":true,"author":"Florian Roth","created":"2019-10-25","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects a Run/RunOnce registry key pointing to a user-writable path.","tags":["attack.persistence","attack.t1547.001"],"logsource":{"category":"registry_set","product":"windows"},"detection":{"selection":{"TargetObject|contains":["\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"],"Details|contains":["\\Users\\Public\\","\\Temp\\","\\AppData\\"]},"condition":"selection"},"rule_type":"registry"},
  {"id":"cloud_aws_ct_root_console_login","title":"AWS Root Console Login","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/","license":"DRL 1.1","license_verified":true,"author":"Michael Haag","created":"2020-01-15","modified":"2023-01-05","level":"high","status":"stable","description":"Detects a successful console login using the AWS root account (should be extremely rare).","tags":["attack.initial_access","attack.persistence","attack.t1078.004"],"logsource":{"product":"aws","service":"cloudtrail"},"detection":{"selection":{"eventName":"ConsoleLogin","userIdentity.type":"Root","responseElements.ConsoleLogin":"Success"},"condition":"selection"},"rule_type":"field_match"},
  {"id":"identity_okta_admin_role_granted","title":"Okta Admin Role Granted","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/identity/","license":"DRL 1.1","license_verified":true,"author":"NivXRay-community","created":"2022-05-01","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects assignment of an admin role in Okta.","tags":["attack.persistence","attack.t1098"],"logsource":{"product":"okta"},"detection":{"selection":{"eventType":"user.account.privilege.grant","target.type":"AppInstance"},"condition":"selection"},"rule_type":"field_match"},
  {"id":"email_o365_susp_forwarding","title":"O365 Suspicious Mailbox Forwarding Rule","source":"SigmaHQ","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/office365/","license":"DRL 1.1","license_verified":true,"author":"Michael Haag","created":"2020-05-01","modified":"2023-01-05","level":"medium","status":"stable","description":"Detects creation of an inbox rule that forwards mail externally.","tags":["attack.collection","attack.t1114.003"],"logsource":{"product":"office365"},"detection":{"selection":{"Operation":["New-InboxRule","Set-InboxRule"],"Parameters|contains":["ForwardTo","RedirectTo"]},"condition":"selection"},"rule_type":"field_match"},
  {"id":"ioc_file_hash_watchlist","title":"IOC File Hash Watchlist Match","source":"NivXRay-native","source_url":"local://ioc-watchlist","license":"NivXRay Public Content","license_verified":true,"author":"NivXRay","created":"2026-02-30","modified":"2026-02-30","level":"informational","status":"stable","description":"Fires when a file hash observed on the wire matches the tenant IOC watchlist. Evidence-only.","tags":["attack.command_and_control"],"logsource":{},"detection":{"selection":{"hash.sha256|watchlist":"ioc.file.sha256"},"condition":"selection"},"rule_type":"ioc"},
  {"id":"ioc_network_watchlist","title":"IOC Network Watchlist Match","source":"NivXRay-native","source_url":"local://ioc-watchlist","license":"NivXRay Public Content","license_verified":true,"author":"NivXRay","created":"2026-02-30","modified":"2026-02-30","level":"informational","status":"stable","description":"Fires when a destination IP/domain matches the tenant IOC watchlist. Evidence-only.","tags":["attack.command_and_control","attack.t1071"],"logsource":{},"detection":{"selection":{"dst_ip|watchlist":"ioc.network.ip","dst_domain|watchlist":"ioc.network.domain"},"condition":"selection"},"rule_type":"ioc"},
  {"id":"behavior_lolbin_from_office","title":"Behavior · LOLBIN Spawned By Office (Correlated)","source":"NivXRay-native","source_url":"local://behavior","license":"NivXRay Public Content","license_verified":true,"author":"NivXRay","created":"2026-02-30","modified":"2026-02-30","level":"low","status":"stable","description":"CAPABILITY observation — LOLBIN child of an Office product. Evidence for correlation, NEVER an automatic verdict.","tags":["attack.execution","attack.defense_evasion"],"logsource":{"category":"process_creation","product":"windows"},"detection":{"selection_parent":{"ParentImage|endswith":["\\winword.exe","\\excel.exe","\\outlook.exe","\\powerpnt.exe"]},"selection_child_lolbin":{"Image|endswith":["\\regsvr32.exe","\\rundll32.exe","\\mshta.exe","\\certutil.exe","\\bitsadmin.exe","\\installutil.exe","\\msbuild.exe","\\wmic.exe","\\hh.exe","\\wscript.exe","\\cscript.exe"]},"condition":"selection_parent and selection_child_lolbin"},"rule_type":"parent_child","capability_not_verdict":true}
