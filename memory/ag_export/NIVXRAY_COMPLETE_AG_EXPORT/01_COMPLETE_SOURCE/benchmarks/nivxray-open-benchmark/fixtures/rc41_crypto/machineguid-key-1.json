{
  "id": "machineguid-key-1",
  "category": "ps-crypto",
  "algorithm": "AES-CBC",
  "command_line": "$mid = (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Cryptography').MachineGuid; $k = [Text.Encoding]::UTF8.GetBytes($mid.PadRight(32).Substring(0,32)); $c = [Convert]::FromBase64String('TUlEXzE='); $aes = [System.Security.Cryptography.Aes]::Create(); $aes.Key = $k; $aes.IV = New-Object byte[] 16; $aes.Mode = 'CBC'; $dec = $aes.CreateDecryptor(); $plain = $dec.TransformFinalBlock($c, 0, $c.Length); IEX ([Text.Encoding]::UTF8.GetString($plain))",
  "stage_ladder": [
    {
      "name": "read-machineguid-reg",
      "recoverable": false,
      "reason": "Key derived from MachineGuid \u2014 per-host, not statically recoverable."
